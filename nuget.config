<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="GitHub-FCS">
      <package pattern="FCS.*" />
      <package pattern="Fcs.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

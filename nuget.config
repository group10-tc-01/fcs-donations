<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="GitHub-FCG">
      <package pattern="FCG.*" />
      <package pattern="Fcg.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
